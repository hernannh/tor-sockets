# syntax=docker/dockerfile:1.7
# Tor-Sockets ingestion worker (Bun) - multi-stage build.
#
# Build context = repo root:
#   docker build -f docker/Dockerfile.ingestion -t tor-sockets-ingestion:latest .
#
# Run (requiere DATABASE_URL, REDIS_URL, ONIONOO_BASE_URL):
#   docker run \
#     -e DATABASE_URL=... -e REDIS_URL=... \
#     tor-sockets-ingestion:latest

ARG BUN_VERSION=1.3
ARG NODE_VERSION=22-bookworm-slim

# --- deps ---
# Installed with pnpm on Node, not with Bun.
#
# Bun cannot read this repo's lockfile: `bun install --frozen-lockfile` fails
# with `InvalidPnpmLockfile: failed to migrate lockfile`, then refuses to
# continue because the (ignored) lockfile "had changes". Dropping the flag would
# have let Bun resolve straight from the manifests instead - installing whatever
# is current rather than what pnpm-lock.yaml pins, which quietly throws away the
# reproducibility the lockfile exists to provide. pnpm is the source of truth for
# dependencies here; Bun is only the runtime, and it reads a node_modules tree
# happily regardless of who wrote it. Same split CI already uses.
FROM node:${NODE_VERSION} AS deps
WORKDIR /repo
RUN corepack enable
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY biome.json tsconfig.base.json turbo.json ./
COPY apps/ingestion/package.json apps/ingestion/
COPY packages/db/package.json packages/db/
COPY packages/ingestion-core/package.json packages/ingestion-core/
COPY packages/api-contract/package.json packages/api-contract/
COPY packages/config/package.json packages/config/
# analysis and federation are runtime dependencies of the worker (the job code
# imports both) and were missing from this list, so their workspace links would
# never have resolved.
COPY packages/analysis/package.json packages/analysis/
COPY packages/federation/package.json packages/federation/
# `--prod` matters for more than size: without it the runtime image shipped the
# whole dev toolchain of every workspace package, and the image scan flagged two
# vendored esbuild binaries (0.18.20 and 0.19.12, Go stdlib 1.20) plus postcss -
# none of which the worker can even reach. Bun runs the TypeScript directly, so
# nothing in devDependencies is needed at runtime.
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm install --prod --frozen-lockfile --filter=@tor-sockets/ingestion... --include-workspace-root

# --- run ---
FROM oven/bun:${BUN_VERSION}-debian AS run
WORKDIR /app
ENV NODE_ENV=production
# The stock `bun` account (uid 1000) is NOT reused here, and the image's own
# `bun` group must not be recreated either - `groupadd bun` aborts the build with
# "group already exists" (exit 9).
#
# Instead a dedicated uid 1001 that MATCHES the web image's `nextjs`. The two
# containers share the federation keypair through a named volume, and that key is
# written 0600 (owner-only, as a private key should be), so sharing it requires
# sharing the uid - no group arrangement can substitute.
# The base image lags the Debian security repo by however long it has been since
# it was published - the scan found libssl3t64, openssl-provider-legacy and
# libcap2 all one point release behind. Upgrading at build time picks up whatever
# is current the day the image is built instead of the day the base was cut.
RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*
RUN groupadd --system --gid 1001 torsockets \
    && useradd --system --uid 1001 --gid torsockets --no-create-home torsockets \
    && mkdir -p /data/federation \
    && chown 1001:1001 /data/federation \
    && chmod 0700 /data/federation
COPY --from=deps --chown=1001:1001 /repo/node_modules ./node_modules
COPY --from=deps --chown=1001:1001 /repo/apps/ingestion/node_modules ./apps/ingestion/node_modules
# Sources of the workspace packages, from the build context. `deps` only holds
# their package.json files, so copying `packages` from that stage alone shipped
# empty shells: the worker would have crashed on its first import of
# @tor-sockets/db. Bun runs the TypeScript directly, so the sources ARE the
# artifact here - there is no build step to fall back on.
COPY --chown=1001:1001 packages ./packages
COPY --from=deps --chown=1001:1001 /repo/packages ./packages
COPY --chown=1001:1001 apps/ingestion/src ./apps/ingestion/src
COPY --chown=1001:1001 apps/ingestion/package.json tsconfig.base.json pnpm-workspace.yaml ./
USER torsockets
# Bun runs TypeScript natively, so there is no build step. The entrypoint
# schedules the recurring poll and runs one immediately on boot.
CMD ["bun", "run", "apps/ingestion/src/index.ts"]
