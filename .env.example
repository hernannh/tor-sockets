# --- Database (Postgres 17 + TimescaleDB) ---
POSTGRES_USER=torsockets
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=torsockets
# Host port the container publishes on. 5433 by default so it does not clash
# with a Postgres already running on the host. Keep it in sync with the port in
# DATABASE_URL below.
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql://torsockets:change-me-in-prod@localhost:5433/torsockets?sslmode=disable

# --- Redis ---
REDIS_URL=redis://:CHANGE-ME-REDIS-PASSWORD@localhost:6379
# Generate with `openssl rand -base64 32`. The same value must appear as the
# password in REDIS_URL above: compose passes this one to redis --requirepass.
REDIS_PASSWORD=
# Host port the container publishes on.
REDIS_HOST_PORT=6379

# --- Onionoo (data source) ---
ONIONOO_BASE_URL=https://onionoo.torproject.org
# Poll cadence (cron). Default: top of every hour (matches the consensus cycle).
# Onionoo republishes at roughly HH:10, so polling at HH:00 picked up every
# consensus a full hour late. A miss costs an hour of staleness; an extra poll
# costs ~900ms and no transfer (If-Modified-Since returns 304), so it polls more
# often than the data changes on purpose.
ONIONOO_POLL_CRON='*/20 * * * *'
# Hard timeout (ms) on the upstream fetch. A stalled connection would otherwise
# hang the single-concurrency worker; this aborts it so the job retries.
# Sized against the real payload: /details with RELAY_FIELDS is ~90 MB for ~10.8k
# relays and Onionoo serves it UNCOMPRESSED (no content-encoding, gzip request
# notwithstanding), so a healthy poll is 30-90s depending on the link. The former
# 60s default aborted polls that were nearly done.
ONIONOO_FETCH_TIMEOUT_MS=300000

# --- PeeringDB (ASN → org mapping for the hoster dimension) ---
# PEERINGDB_BASE_URL=https://www.peeringdb.com
# Optional API key - raises the anonymous rate limit (not required for weekly sync)
# PEERINGDB_API_KEY=
# Refresh cadence (cron). Default: Mondays 04:00
# PEERINGDB_SYNC_CRON='0 4 * * 1'

# --- Consensus cross-check (raw consensus vs Onionoo provenance) ---
# Fetches the latest directory-authority-signed consensus from CollecTor and
# confirms/diverges relays against the Onionoo-derived table. Uses COLLECTOR
# base URL from the collector adapter default. Cadence (cron). Default: every 6h.
# CONSENSUS_CHECK_CRON='30 */6 * * *'

# --- Federation peer sync ---
# Pull + cross-verify known peers (gossip). Cadence (cron). Default: every 15 min.
# PEER_SYNC_CRON='*/15 * * * *'
# Marks this instance as the second peering instance (local dev only): uses a
# separate .next-peer dir and .env-peer so two instances run side by side.
# PEER_MODE=

# --- Maintenance ---
# Daily prune of the append-only tables (anomalies, alert_events,
# federation_log). Rows older than this are deleted; hypertables keep their own
# Timescale retention (5y). Default: 365 days.
# LOG_RETENTION_DAYS=365
# PRUNE_CRON='17 4 * * *'

# --- Federation (Ed25519 instance keypair) ---
# Generated on first boot if missing. NEVER commit a private key.
# MUST be an ABSOLUTE path: web (apps/web) and ingestion (apps/ingestion) run
# from different working directories, so a relative path would resolve to two
# different files and split the instance identity in half.
#
# The default below is fine for local development, but /tmp does not survive a
# reboot, and the keypair IS the instance identity: regenerating it means the
# same URL becomes a different instance to every peer that already trusted it.
# Any deployment that peers with anyone must point this at persistent storage.
# The Docker stacks already do, at /data/federation/instance.ed25519.
# Auto-generated: SHA-256 of the public key. Leave empty.
FEDERATION_INSTANCE_ID=
FEDERATION_PRIVATE_KEY_PATH=/tmp/tor-sockets/federation/instance.ed25519
# NOTE: the key is persisted as base64 with filesystem perms 0600 only. This
# value is NOT used by the current loader (no at-rest encryption yet) - kept as
# a placeholder for a future encrypted-key implementation. Protect the volume.
FEDERATION_KEY_PASSWORD=

# --- Public URL ---
# The canonical origin of this instance. It goes into the federation actor
# document, so peers fetch and verify against exactly this value.
# Set this to the public origin of your own instance before deploying: it is
# also what canonical URLs, the sitemap and robots.txt are built from.
TOR_SOCKETS_BASE_URL=http://localhost:3000
# NEXT_PUBLIC_BASE_URL is gone on purpose. The browser auth client now uses a
# relative /api/auth, i.e. whatever origin served the page. The old variable was
# a trap twice over: Next inlines NEXT_PUBLIC_* at BUILD time, so setting it here
# never reached a running container anyway, and its localhost fallback shipped to
# production - the signup form posted to the visitor's own machine and was
# blocked as mixed content, spinning forever with nothing in the server logs.

# --- Rate limiting / proxy chain ---
# How many TRUSTED proxies sit in front of the app. The client IP is read from
# `x-forwarded-for` counting from the RIGHT by this many hops, because the left
# side of that header is attacker-controlled. 1 = a single nginx/Caddy in front
# (the default deployment). 0 = app exposed directly -> the header is ignored
# and all clients share one bucket. Getting this too HIGH is the dangerous
# direction: it starts trusting client-written entries.
TRUSTED_PROXY_HOPS=1

# --- Outbound fetch guard (SSRF) ---
# Extra destination ports allowed for peer/webhook fetches (443 always allowed).
# FEDERATION_ALLOWED_PORTS=8443
# Local peering only: lets the guard reach 127.0.0.1 so two dev instances can
# federate. IGNORED when NODE_ENV=production - it can never weaken prod.
# SAFE_FETCH_ALLOW_PRIVATE=true

# --- Operator auth (better-auth) ---
# Generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Label shown by authenticator apps next to the 2FA code. Defaults to
# "Tor-Sockets"; set it only if you run several instances and need to tell their
# entries apart. NOT a URL - it is a display name.
# TOTP_ISSUER=Tor-Sockets
# Email verification: required when SMTP_HOST is set. To exercise the flow in
# local dev WITHOUT a mail server, set DEV_LOG_VERIFICATION=true - the
# verification link is then printed to the server console instead of emailed.
# NEVER enable this in production (use real SMTP there).
# DEV_LOG_VERIFICATION=true

# --- Environment ---
# Defaults to production because this single variable gates FIVE controls at
# once, and every one of them fails OPEN when it is not `production`:
#
#   - session cookies lose `Secure`      (packages/auth/src/index.ts)
#   - safeFetch stops being https-only and re-honours SAFE_FETCH_ALLOW_PRIVATE,
#     i.e. the SSRF guard opens up to the internal network
#   - the CSP falls back to allowing 'unsafe-eval'   (apps/web/proxy.ts)
#   - better-auth stops refusing to boot on a default signing secret
#
# The docker stacks pin `NODE_ENV: production` in their `environment:` block, so
# this line only matters when running outside compose (systemd, bare node,
# `next start`) - which is exactly the case where nothing else would catch it.
# Set it to `development` on a workstation, never on a host reachable from
# outside.
NODE_ENV=production

# --- Alert delivery ---
# All optional - channels are no-ops until configured. Default alert rules
# (seeded on first worker boot) pick up these targets automatically.
# Webhook receives a signed POST (Ed25519, same key as federation).
ALERT_WEBHOOK_URL=
# Email via SMTP (nodemailer). Set SMTP_HOST + SMTP_FROM to activate.
ALERT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Telegram Bot API. Set TELEGRAM_BOT_TOKEN to activate.
ALERT_TELEGRAM_CHAT=
TELEGRAM_BOT_TOKEN=

# --- Observability (OpenTelemetry) ---
# Opt-in. Unset = tracing disabled (zero overhead). Set the endpoint to the
# Jaeger collector from docker/compose.yml to trace the web SSR → DB path.
# UI: http://localhost:16686
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=tor-sockets-web
